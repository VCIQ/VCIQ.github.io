# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.pytest_cache/

# python
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# Social discovery: fallback protection only; runtime state belongs outside both repositories.
/.social-state/
/.social-shadow/
/social-state/
/mediacrawler-data/
/browser_data/
/playwright/.auth/
**/*_user_data_dir/
**/storage_state*.json
**/auth_state*.json
